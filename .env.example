# StudyOS Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/studyos

# Authentication Security
JWT_SECRET=change_this_for_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_for_production
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend
# Browser app URL used by backend CORS allow-list
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed frontend origins for backend CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Google OAuth client ID used to verify browser Google sign-in tokens
GOOGLE_CLIENT_ID=
# Optional: set this in frontend/.env.local for a custom API target.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api/v1
# Frontend Google Identity client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
