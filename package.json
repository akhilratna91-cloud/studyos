{
  "name": "studyos",
  "version": "1.0.0",
  "description": "StudyOS - AI-Powered Study Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:start": "npm run start --prefix frontend",
    "frontend:lint": "npm run lint --prefix frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "public:start": "powershell -ExecutionPolicy Bypass -File scripts/start-public-tunnel.ps1",
    "public:url": "powershell -ExecutionPolicy Bypass -File scripts/get-public-url.ps1",
    "public:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-public-tunnel.ps1",
    "smoke:test": "node scripts/smoke-test-studyos.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "study",
    "education",
    "ai",
    "platform"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2"
  }
}
